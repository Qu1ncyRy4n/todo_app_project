#!/usr/bin/env sh
set -eu

usage() {
  cat <<'EOF'
Usage: ./dev <command> [arguments]

Commands:
  build [--debug|--release]
                    Build the workspace (debug by default).
  test              Run workspace tests.
  check             Check formatting and run Clippy with warnings denied.
  fmt               Format Rust sources.
  run -- <args>     Run the todo CLI with <args>.
  gui [--debug|--release]
                    Run the graph editor (release by default).
  install           Install todo and todo-gui into the Nix user profile.
EOF
}

command=${1:-help}
case "$command" in
  build)
    shift
    if [ "$#" -gt 1 ]; then
      usage >&2
      exit 2
    fi
    case "${1:-}" in
      ""|--debug) nix develop --command cargo build --workspace ;;
      --release) nix develop --command cargo build --release --workspace ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  test)
    nix develop --command cargo test --workspace
    ;;
  check)
    nix develop --command cargo fmt --check
    nix develop --command cargo clippy --workspace --all-targets --all-features -- -D warnings
    ;;
  fmt)
    nix develop --command cargo fmt
    ;;
  run)
    shift
    if [ "${1:-}" != "--" ]; then
      usage >&2
      exit 2
    fi
    shift
    nix develop --command cargo run -p todo-cli -- "$@"
    ;;
  gui)
    shift
    if [ "$#" -gt 1 ]; then
      usage >&2
      exit 2
    fi
    case "${1:-}" in
      ""|--release) nix develop --command cargo run --release -p todo-gui ;;
      --debug) nix develop --command cargo run -p todo-gui ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  install)
    # Replace rather than upgrade: an upgrade refetches from the path recorded at
    # install time, which breaks once the checkout moves. A second install
    # without the remove would add a duplicate entry.
    # grep -q would exit early and make nix report a broken pipe.
    if nix profile list | grep -E '^Name:[[:space:]]+todo$' >/dev/null; then
      nix profile remove todo
    fi
    nix profile install .#todo
    # The Cargo bin directory precedes the Nix profile on PATH, so older
    # `cargo install` copies of todo or todo-gui would shadow the profile ones.
    if [ -x "${CARGO_HOME:-$HOME/.cargo}/bin/todo" ]; then
      nix develop --command cargo uninstall todo-cli
    fi
    if [ -x "${CARGO_HOME:-$HOME/.cargo}/bin/todo-gui" ]; then
      nix develop --command cargo uninstall todo-gui
    fi
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
